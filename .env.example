DATABASE_URL=mysql://renovate_user:your_password@localhost:3306/renovate_ge
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=renovate_user
DATABASE_PASSWORD=your_password
DATABASE_NAME=renovate_ge
# TLS to MySQL: `true` for a hosted database (PlanetScale, TiDB Cloud, Aiven, DigitalOcean —
# all of them refuse plain connections). DATABASE_SSL_CA is the provider's CA certificate
# (PEM) when it signs with its own authority; leave it empty for a public one, and leave both
# off for a local server.
DATABASE_SSL=false
DATABASE_SSL_CA=

NEXTAUTH_SECRET=replace-with-strong-random-string
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-strong-random-string
AUTH_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Reading uploaded floor plans with Claude. Optional: without it the Design Studio falls back
# to the deterministic CV parser, which finds rooms but cannot read the printed dimensions.
# Enables the Claude floor-plan reader (parse-plan). Without it the deterministic CV parser
# takes over. Test a real plan with `pnpm plan:ai <file>` once set.
ANTHROPIC_API_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=რემონტი.ge

# Seed admin account (`pnpm db:seed`). Without ADMIN_PASSWORD the seed generates a random
# password and prints it once; in production it refuses to seed the admin without one.
ADMIN_EMAIL=admin@remonti.ge
ADMIN_PASSWORD=

# Uploads: `local` writes to public/uploads; `s3` sends them to an S3-compatible bucket
# (AWS S3, Cloudflare R2, MinIO). S3_PUBLIC_URL is the base URL files are served from.
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Mail: `log` writes every message to the log instead of sending (development);
# `smtp` sends through the server below (password reset, email verification).
MAIL_DRIVER=log
MAIL_FROM="რემონტი.ge <no-reply@remonti.ge>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# Logging: JSON lines to stdout and to LOG_DIR/app-YYYY-MM-DD.log (default ./logs).
# LOG_FILE=false keeps them on stdout only — the setting for Vercel, whose filesystem is read-only.
LOG_DIR=
LOG_LEVEL=info
LOG_FILE=true

# --- Vercel ---
# The function filesystem is read-only, so production there runs STORAGE_DRIVER=s3 (Cloudflare
# R2 or S3; with `local` every upload fails with EROFS), LOG_FILE=false, and a hosted MySQL
# reached with DATABASE_SSL=true. Set AUTH_URL and NEXT_PUBLIC_APP_URL to the production
# domain (NextAuth trusts Vercel's host header by itself). Do not set NODE_ENV: the build sets
# it, and setting it by hand makes the install skip the devDependencies the build needs.
# `output: 'standalone'` switches itself off on the VERCEL variable Vercel sets (next.config.mjs).
