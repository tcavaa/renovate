# Every variable the app reads (docs/operations.md#environment). Copy to .env.local for local
# development; on Vercel they are the project's environment variables. Never commit real values.

# PostgreSQL. Locally: a local server (`createdb renovate_ge`, then `pnpm db:migrate` and the seeds).
# On Vercel: Supabase's transaction pooler (port 6543) with the app's own role, e.g.
# postgresql://renovate_app.<project-ref>:<password>@aws-1-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://localhost:5432/renovate_ge
# Where migrations and the scripts connect, when that should not be DATABASE_URL: Supabase's
# session pooler (same host, port 5432). Empty: DATABASE_URL.
DATABASE_MIGRATION_URL=
# TLS to the database: `true` for any hosted one. DATABASE_SSL_CA is the provider's CA (PEM), or
# `supabase` for Supabase's own root (bundled in lib/db/supabaseCa.ts); empty for a public CA.
# Leave both off for a local server. Never put sslmode=… in the URL: these decide TLS.
DATABASE_SSL=false
DATABASE_SSL_CA=
# Connections per server instance (default: 5 on Vercel, 10 elsewhere).
DATABASE_POOL_MAX=

AUTH_SECRET=replace-with-strong-random-string
# Pin Auth.js to one origin. Locally the dev server's; on Vercel leave it empty (the host is trusted).
AUTH_URL=http://localhost:3000

# Social logins. Each is optional and both halves of a pair are needed: set the two keys
# and the matching NEXT_PUBLIC_*_ENABLED below, and the button appears on the login page.
# Each provider's console must list the deployment's redirect URI (<origin>/api/auth/callback/google).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_ENABLED=false
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
NEXT_PUBLIC_FACEBOOK_ENABLED=false

# Enables the Claude floor-plan reader (parse-plan). Without it the deterministic CV parser
# takes over. Test a real plan with `pnpm plan:ai <file>` once set.
ANTHROPIC_API_KEY=

# The site's public origin: mail links and Flitt's callback. Baked into the build.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=რემონტი.ge

# Seed admin account (`pnpm db:seed`). Without ADMIN_PASSWORD the seed generates a random
# password and prints it once; in production it refuses to seed the admin without one.
ADMIN_EMAIL=admin@remonti.ge
ADMIN_PASSWORD=

# Uploads (docs/uploads.md): `local` keeps files in public/uploads (development; refused on
# Vercel, whose disk is read-only); `supabase` keeps them in Supabase Storage — a public bucket
# for what the site shows, a private one where browsers send files before they are checked.
STORAGE_DRIVER=local
# The project's URL (also read at build time, for the CSP) and a server-only key: the secret key
# (sb_secret_…, Project Settings → API Keys) or the legacy service_role key. Never NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLIC_BUCKET=uploads
SUPABASE_STAGING_BUCKET=uploads-staging

# What Vercel Cron sends as `Authorization: Bearer …` to /api/cron/cleanup. Unset: refused.
CRON_SECRET=

# Mail: `log` writes every message to the log instead of sending (development; on Vercel the
# runtime logs); `smtp` sends through the server below — port 587 or 465 (Vercel blocks 25).
MAIL_DRIVER=log
MAIL_FROM="რემონტი.ge <no-reply@remonti.ge>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# Card payments through Flitt (docs/payments.md). Empty = Flitt's public test merchant
# (1549901 / test): the sandbox, nothing is charged — pay with 4444 5555 6666 1111, any date and
# CVV. Your own merchant: its id and payment key from portal.flitt.com → Technical settings.
# FLITT_TEST_MODE=false only once Flitt has switched that merchant to live. Flitt posts each
# result to NEXT_PUBLIC_APP_URL/api/payments/flitt/callback, from 54.154.216.60 and 3.75.125.89.
FLITT_MERCHANT_ID=
FLITT_SECRET_KEY=
FLITT_TEST_MODE=true

# Logging: JSON lines to stdout, and off Vercel also to LOG_DIR/app-YYYY-MM-DD.log (default ./logs).
# LOG_FILE=false keeps them on stdout only (the default on Vercel, whose disk is read-only).
LOG_DIR=
LOG_LEVEL=info
LOG_FILE=

# Sentry, the error tracker (docs/operations.md#errors-go-to-sentry). Empty DSN = off. The DSN
# is public (it only sends events) and is baked into the browser bundle, so it has to be set
# where the build runs — on Vercel, a project variable.
# Sentry → Settings → Projects → javascript-nextjs → Client Keys (DSN).
# NEXT_PUBLIC_SENTRY_ENVIRONMENT overrides the environment label (default: development /
# production; `vercel` on the Vercel deployment).
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Build only: uploads the browser source maps so stack traces read as source. Secret — an
# organization token from Sentry → Settings → Auth Tokens. Unset, the build makes no source maps.
SENTRY_AUTH_TOKEN=

